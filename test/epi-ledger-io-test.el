            (inspected-payload-before
             (epi-test-ledger-io--wave3-copy-value
              (epi-record--raw-payload inspected)))
            (caller-payload-before
             (epi-test-ledger-io--wave3-copy-value
              (epi-record--raw-payload caller)))
