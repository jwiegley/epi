                   (epi-ledger--recovery-transfer-objects prepared))))))
      (ignore forced-garbage)
      (should unlocked)
      (should (= 2 probes))
      (should probed)
      (should-not fired)
      (should-not identities)
      (should (epi-test-wave4-hardening--returned-p outcome))
      (setq successor (cadr outcome)
