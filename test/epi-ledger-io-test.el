(ert-deftest epi-ledger-append-flush-error-marks-handle-uncertain ()
  (should (fboundp 'epi-ledger--append))
  (epi-test-with-temporary-root (root)
    (let* ((ledger (epi-test-ledger-io--wave5-open root))
