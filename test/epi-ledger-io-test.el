      (should-not (eq caller retained))
      (epi-test-wave4-ownership--assert-disjoint
       (epi-test-wave4-ownership--record-values inspected)
       (epi-test-wave4-ownership--record-values retained))
      (epi-test-wave4-ownership--assert-disjoint
