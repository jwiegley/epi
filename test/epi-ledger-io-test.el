                       "wave5-limit-reachable" 'utf-8-unix))))
         (source (plist-get case :source)))
    (dotimes (index (1- total))
      (epi-test-ledger-io--wave3-extra-write-object
       source (format "wave5-limit-unreachable-%03d" index)))
