           (expected (epi-ledger--checkpoint-snapshot ledger))
           (before (epi-test-ledger-io--wave5-bytes ledger))
           (real-append epi-ledger--append-function)
           (writer-count 0)
           (flush-count 0)
           (epi-ledger--append-function
            (lambda (path suffix)
