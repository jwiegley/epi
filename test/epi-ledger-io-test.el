       (= (plist-get temporary-identity :size)
          (plist-get corrupted-identity :size)))
      (should
       (equal (plist-get temporary-identity :modified)
              (plist-get corrupted-identity :modified)))
      (epi-test-wave4-hardening--assert-conflict outcome)
