                          (epi-test-ledger-io--condition-code
                           condition))))))
        (should-not (file-exists-p current-lock-path)))
      (dolist (probe '(attributes process-list))
        (epi-test-ledger-io--wave2-with-forbidden-mutations
          (cl-letf
              (((symbol-function 'process-attributes)
