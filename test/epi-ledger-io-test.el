        (should (= (plist-get expected :size) (plist-get preserved :size)))
        (should (= 1 (plist-get preserved :links)))
        (should (= #o600 (epi-ledger--recovery-raw-mode source)))
        (should
         (equal
          (plist-get (aref (plist-get proof :items) 0) :hash)
